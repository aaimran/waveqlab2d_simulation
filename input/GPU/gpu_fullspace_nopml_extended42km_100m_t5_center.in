# WaveQLab2D full-space no-PML reflection-control test
# The 42x42 km domain is sized so a hypothetical reflected P wave cannot return
# to the centered 20x20 km objective window within the 5 s simulation window.

# Compute
compute_backend = cuda
precision = float64
gpu_device = 0

# Output: centered 20x20 km objective window
output_prefix = gpu_fullspace_nopml_extended42km_100m_t5_center
output_format = hdf5
output_compression = compressed
output_streaming = true
output_timing = true
output_mode = subdomain
output_xlim = -10,10
output_ylim = 11,31
station_file = none
station_stride = 1
station_interpolation = nearest
station_include_fault = false
iplot = 10

# No PML; SAT absorbing conditions remain on all four outer boundaries
absorbing_method = sat
pml_width = 0
pml_profile_order = 3
pml_reflection_target = 1e-6
pml_max_damping = auto
boundary_x_left = absorbing
boundary_x_right = absorbing
boundary_y_surface = absorbing
boundary_y_depth = absorbing
pml_x_left = false
pml_x_right = false
pml_y_surface = false
pml_y_depth = false

# Elastic material
response = elastic
q_storage = conventional
coarse_grain = false
Qp = 1000000000.0
Qs = 1000000000.0
cp = 6.0
cs = 3.464
rho = 2.6702

# Time and discretization
dt = 0.002
tend = 5.0
cfl = 0.5
fd_type = central
sbp_family = diagonal
fd_order = 6
order = 6
mode = II
interface = none

# 42x42 km domain at 100 m resolution
x_left_length = 21.0
x_right_length = 21.0
y_length = 42.0
x_left_resolution = 0.1
x_right_resolution = 0.1
y_resolution = 0.1

# Centered Gaussian point source
simulation_type = PointSource
source_type = Gaussian
M0 = 0.02824
x0 = 0.0
y0 = 21.0
t0 = 1.0
T = 0.2
